        "foreign_keys": {
          "reservationId": "reservation.reservationId",
          "userId": "students.userId",
          "examId": "exam.examId"
        },
        "relations": {
          "belongs_to": ["students", "exam", "reservation"]
        }
      },
      "trainingReservation": {
        "columns": {
          "trainingReservationId": { "type": "uuid", "primary": true, "nullable": false },
