{
    "tables": {
      "users": {
        "columns": {
          "userId": { "type": "uuid", "primary": true, "nullable": false, "unique": true },
          "email": { "type": "string(255)", "nullable": false, "unique": true },
          "passwordHash": { "type": "string(255)", "nullable": false },
          "role": { "type": "enum('STUDENT','ADMIN','MANAGER','TRAINER','SUPERVISOR','SUPERADMIN')", "nullable": false },
          "tokenVersion": { "type": "integer", "nullable": false, "default": 0 }
        },
        "primary_key": ["userId"],
        "foreign_keys": {},
        "unique_constraints": [["email"]],
        "relations": {
          "has_one": ["students", "trainer", "supervisor", "SuperAdmin", "Admin"],
          "has_many": ["payments", "notifications", "messages", "conversation_users", "conversations"],
          "belongs_to_many": ["course", "permissions", "conversations"],
          "belongs_to": []
        }
      },
      "students": {
        "columns": {
          "userId": { "type": "uuid", "primary": true, "nullable": false, "unique": true, "foreign_key": "users.userId" },
          "fullName": { "type": "string(200)", "nullable": false },
          "NameEn": { "type": "string(200)", "nullable": false },
          "Mobile": { "type": "string(200)", "nullable": false },
          "StudyLan": { "type": "string(200)", "nullable": false },
          "nationality": { "type": "string(100)", "nullable": true },
          "QRdata": { "type": "string(200)", "nullable": true },
          "nationalId": { "type": "string(50)", "nullable": false, "unique": true },
          "nationalIdImage": { "type": "string(300)", "nullable": true },
          "university": { "type": "string(150)", "nullable": true },
          "college": { "type": "string(150)", "nullable": true },
          "department": { "type": "string(150)", "nullable": true },
          "type": { "type": "enum('1','2','3','4')", "nullable": true },
          "status": { "type": "string(200)", "nullable": false },
          "profilePhoto": { "type": "string(10000)", "nullable": true },
          "productId": { "type": "uuid", "nullable": true, "foreign_key": "products.productId" }
        },
        "primary_key": ["userId"],
        "foreign_keys": {
          "userId": "users.userId",
          "productId": "products.productId"
        },
        "unique_constraints": [["userId"], ["nationalId"]],
        "relations": {
          "belongs_to": ["users", "products"],
          "has_many": ["payments", "examReservation", "trainingReservation", "studentCourse", "reservation", "attendance", "efada", "Reexam", "RegisterRequest"]
        }
      },
      "products": {
        "columns": {
          "productId": { "type": "uuid", "primary": true, "nullable": false },
          "courseName": { "type": "string(200)", "nullable": false },
          "priceEgyptian": { "type": "decimal(12,2)", "nullable": false, "default": 0 },
          "priceOther": { "type": "decimal(12,2)", "nullable": false, "default": 0 },
          "currencyId": { "type": "uuid", "nullable": true, "foreign_key": "currency.currencyId" },
          "examStatus": { "type": "boolean", "nullable": true, "default": true },
          "trainingStatus": { "type": "boolean", "nullable": true, "default": true },
          "requirdCourses": { "type": "integer", "nullable": true },
          "receiptId": { "type": "integer", "nullable": true, "foreign_key": "Receipts.receiptId" },
          "receiptIdOthers": { "type": "integer", "nullable": true, "foreign_key": "Receipts.receiptId" }
        },
        "primary_key": ["productId"],
        "foreign_keys": {
          "currencyId": "currency.currencyId",
          "receiptId": "Receipts.receiptId",
          "receiptIdOthers": "Receipts.receiptId"
        },
        "relations": {
          "belongs_to": ["currency", "Receipts"],
          "has_many": ["payments", "students", "events", "Reexam"],
          "belongs_to_many": ["course", "packages"],
          "has_many_through": ["product_allowed_user_types", "productCourse", "packageProduct"]
        }
      },
      "payments": {
        "columns": {
          "paymentId": { "type": "uuid", "primary": true, "nullable": false },
          "userId": { "type": "uuid", "nullable": false, "foreign_key": "users.userId" },
          "receiptId": { "type": "integer", "nullable": true },
          "orderId": { "type": "string(100)", "nullable": true },
          "currencyId": { "type": "uuid", "nullable": true, "foreign_key": "currency.currencyId" },
          "productId": { "type": "uuid", "nullable": true, "foreign_key": "products.productId" },
          "serviceId": { "type": "uuid", "nullable": true, "foreign_key": "services.serviceId" },
          "amount": { "type": "decimal(12,2)", "nullable": true },
          "actualAmount": { "type": "decimal(12,2)", "nullable": true },
          "timestamp": { "type": "date", "nullable": false },
          "status": { "type": "enum('PENDING','SUCCESS','FAILED','PAID')", "nullable": false, "default": "PENDING" }
        },
        "primary_key": ["paymentId"],
        "foreign_keys": {
          "userId": "users.userId",
          "currencyId": "currency.currencyId",
          "productId": "products.productId",
          "serviceId": "services.serviceId"
        },
        "relations": {
          "belongs_to": ["users", "students", "products", "currency", "services"],
          "has_many": ["efada", "Reexam", "RegisterRequest"]
        }
      },
      "university": {
        "columns": {
          "UniversityId": { "type": "uuid", "primary": true, "nullable": false },
          "Name": { "type": "string(200)", "nullable": false }
        },
        "primary_key": ["UniversityId"],
        "relations": {
          "has_many": ["universityCollege"],
          "belongs_to_many": ["colleges"]
        }
      },
      "colleges": {
        "columns": {
          "collegeId": { "type": "uuid", "primary": true, "nullable": false },
