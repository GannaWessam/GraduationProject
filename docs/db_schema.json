          "reservationId": { "type": "uuid", "nullable": true, "foreign_key": "reservation.reservationId" },
          "userId": { "type": "uuid", "nullable": false, "foreign_key": "students.userId" },
          "examId": { "type": "uuid", "nullable": true, "foreign_key": "exam.examId" },
