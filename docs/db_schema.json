        },
        "primary_key": ["collegeId"],
        "relations": {
          "has_many": ["universityCollege", "Department"],
          "belongs_to_many": ["university"]
        }
      },
      "universityCollege": {
        "columns": {
          "Id": { "type": "uuid", "primary": true, "nullable": false },
          "universityId": { "type": "uuid", "nullable": false, "foreign_key": "university.UniversityId" },
          "collegeId": { "type": "uuid", "nullable": false, "foreign_key": "colleges.collegeId" }
        },
        "primary_key": ["Id"],
        "foreign_keys": {
          "universityId": "university.UniversityId",
          "collegeId": "colleges.collegeId"
        },
        "relations": {
          "belongs_to": ["university", "colleges"]
        }
      },
      "Department": {
        "columns": {
          "DepartmentId": { "type": "uuid", "primary": true, "nullable": false },
          "Name": { "type": "string(200)", "nullable": false },
          "CollegeId": { "type": "uuid", "nullable": false, "foreign_key": "colleges.collegeId" }
        },
        "primary_key": ["DepartmentId"],
        "foreign_keys": {
          "CollegeId": "colleges.collegeId"
        },
        "relations": {
          "belongs_to": ["colleges"]
        }
      },
      "product_allowed_user_types": {
        "columns": {
          "id": { "type": "uuid", "primary": true, "nullable": false },
          "productId": { "type": "uuid", "nullable": false, "foreign_key": "products.productId" },
          "userType": { "type": "enum('1','2','3','4')", "nullable": false }
        },
        "primary_key": ["id"],
        "foreign_keys": {
          "productId": "products.productId"
        },
        "relations": {
          "belongs_to": ["products"]
        }
      },
      "course": {
        "columns": {
          "courseId": { "type": "uuid", "primary": true, "nullable": false },
          "name": { "type": "string(200)", "nullable": false },
          "title": { "type": "string(200)", "nullable": true },
          "priceEgyptian": { "type": "decimal(12,2)", "nullable": false, "default": 0 },
          "priceOther": { "type": "decimal(12,2)", "nullable": false, "default": 0 },
          "currencyId": { "type": "uuid", "nullable": true, "foreign_key": "currency.currencyId" }
